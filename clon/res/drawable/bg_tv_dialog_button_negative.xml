<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#245c5b" />
            <corners android:radius="12.0dp" />
            <stroke android:width="2.0dp" android:color="#72f0df" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1c4547" />
            <corners android:radius="12.0dp" />
            <stroke android:width="2.0dp" android:color="#72f0df" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1b2638" />
            <corners android:radius="12.0dp" />
            <stroke android:width="1.0dp" android:color="#52627d" />
        </shape>
    </item>
</selector>
