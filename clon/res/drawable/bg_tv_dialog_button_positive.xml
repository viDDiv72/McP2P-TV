<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#6c8cff" />
            <corners android:radius="12.0dp" />
            <stroke android:width="2.0dp" android:color="#afc0ff" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3e5fe0" />
            <corners android:radius="12.0dp" />
            <stroke android:width="2.0dp" android:color="#afc0ff" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#263653" />
            <corners android:radius="12.0dp" />
            <stroke android:width="1.0dp" android:color="#6c8cff" />
        </shape>
    </item>
</selector>
