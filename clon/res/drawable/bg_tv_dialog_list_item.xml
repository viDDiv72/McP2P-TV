<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#31566b" />
            <corners android:radius="10.0dp" />
            <stroke android:width="3.0dp" android:color="#48d9c8" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#274454" />
            <corners android:radius="10.0dp" />
            <stroke android:width="2.0dp" android:color="#48d9c8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00202d43" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
</selector>
